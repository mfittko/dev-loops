version: 1

strategy: local-first

inputSource: tracker

refinement:
  maxCopilotRounds: 2

gates:
  # Fail-closed enforcement that gate verdicts were produced by the
  # fan-out/fan-in review sub-loop (executionMode fanout_fanin + a findings-log
  # ledger), not an inline single-agent run. This repo runs enforcement on its
  # own gates; dynamic angle resolution (below) scopes the fan-out per change.
  requireFanoutEvidence: true
  draft:
    dynamic:
      subtractive: true
    angles:
      - scope
      - coverage
      - correctness
      - ci-guard
      - contract-surface
      - input-validation
      - determinism
      - no-op
      - link-check
      - packaging-runtime
      - state-concurrency
      - config-drift
      - gate-evidence
      - name: pr-description
        mandatory: true
      - pr-comments
      - contradiction-lens
      - code-conformance
      - semantic-drift
    requireCi: true
    blockCleanOnFindingSeverities:
      - must-fix
      - worth-fixing-now
  preApproval:
    dynamic:
      subtractive: true
    # Mandatory angles always run in the fan-out (never dropped by dynamic
    # resolution); fully configurable — set `mandatory: true` on any angle.
    angles:
      - dry
      - kiss
      - name: yagni
        mandatory: true
      - srp
      - soc
      - deep
      - docs
      - ocp
      - lsp
      - isp
      - dip
      - renderer-security
      - name: pr-checklist-matrix
        mandatory: true
      - name: acceptance-criteria
        mandatory: true
      - name: contradiction-lens
        mandatory: true
      - correctness-final
      - ui-validation
    blockCleanOnFindingSeverities:
      - must-fix
      - worth-fixing-now

workflow:
  requireRetrospective: true
  requireDraftFirst: true
  devModeDefault: true

localImplementation:
  lightMode:
    enabled: true
    maxFiles: 2
    maxLines: 20 # micro-PR ceiling (#1043)

queue:
  board:
    title: "dev-loops Queue"
  maxParallel: 3
  maxAutoFiledIssues: 10
  reDispatchMaxRetries: 1
  archiveOlderThanDays: 7
