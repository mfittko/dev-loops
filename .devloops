version: 1

strategy: local-first

inputSource: tracker

refinement:
  maxCopilotRounds: 2

gates:
  # Fail-closed enforcement that gate verdicts were produced by the
  # fan-out/fan-in review sub-loop (executionMode fanout_fanin + a findings-log
  # ledger), not an inline single-agent run. This repo runs enforcement on its
  # own gates; dynamic angle resolution (below) scopes the fan-out per change.
  requireFanoutEvidence: true
  # Enforce one distinct reviewer identity per fresh (non-carried) fan-out
  # angle — no two freshly-reviewed angles may share a reviewer. See
  # skills/docs/gate-review-sub-loop-contract.md.
  requireFanoutProvenance: true
  draft:
    dynamic:
      subtractive: true
    # Only per-layer DELTAS live here — angles that merely restate an
    # extension-defaults.yaml draft-pool entry byte-for-byte are a no-op under
    # merge-by-name (D3) and have been trimmed. This repo's draft gate keeps
    # the full shipped draft pool at its shipped persona/prompt/order except
    # for the two explicit drops below.
    angles:
      # Shipped in extension-defaults.yaml's draft pool but intentionally not
      # run by this repo's own draft gate (pre-1.0 config-schema redesign,
      # #1404: gates.<gate>.angles now merges BY NAME across config layers —
      # D3 — so dropping a shipped angle requires an explicit enabled:false
      # entry here; omitting it entirely would let it merge back in).
      - name: threat-model
        enabled: false
      - name: renderer-security
        enabled: false
    requireCi: true
    # Draft gate blocks on must-fix only. With worth-fixing-now also blocking,
    # this gate did not converge on a non-trivial change: correctness settled
    # while worth-fixing-now renewed itself every round, because each fix round
    # creates fresh surface for the next round to review. Measured over eight
    # rounds on one PR (72 reviewer dispatches), must-fix per round ran
    # 1,1,7,0,1,1,3,0 while worth-fixing-now ran 6,11,17,14,16,9,12,7.
    #
    # worth-fixing-now findings still go through the normal fan-in flow
    # (ledger + findings comment) as long as that flow is followed; this key
    # does not itself force a count or a ledger entry for worth-fixing-now
    # (upsert-checkpoint-verdict only requires explicit counts for the
    # severities listed here). They just stop blocking the draft-to-ready
    # transition.
    # preApproval blocks on both, but it re-reviews through its own, mostly
    # disjoint angle pool (draft and preApproval share only contradiction-lens)
    # and does not carry a specific unblocked draft-gate finding forward — the
    # ledger records it "deferred" and nothing re-raises it. A worth-fixing-now
    # finding from a draft-only angle is not "caught later"; it is recorded and
    # left. This also affects light-mode dispatch: resolveGateDispatchMode
    # escalates inline to full fan-out only on a blocking-severity inline
    # finding, so a light-dispatched draft PR whose inline pass surfaces only
    # worth-fixing-now now stays inline instead of escalating.
    #
    # Interim: the better shape is the full severity set with a round cap, so
    # the first rounds still block and only a demonstrated plateau softens.
    # Revisit this once that lands.
    blockCleanOnFindingSeverities:
      - must-fix
  preApproval:
    dynamic:
      subtractive: true
    # Only per-layer DELTAS live here (see the draft-gate comment above for
    # why byte-identical restatements were trimmed). This repo's preApproval
    # gate keeps the full shipped preApproval pool at its shipped
    # persona/prompt/order except for the deltas below: two angles promoted
    # to mandatory, and two additions not in the shipped preApproval pool.
    # Mandatory angles always run in the fan-out (never dropped by dynamic
    # resolution); fully configurable — set `mandatory: true` on any angle.
    angles:
      - name: acceptance-criteria
        mandatory: true
        persona: review
        prompt: Verify that each acceptance criterion and definition-of-done item from the linked issue/PR is actually satisfied by the implementation — not merely listed. For every criterion, cite the concrete code/test/behavior evidence that meets it; flag any criterion that is unmet, only partially met, or unverifiable from the diff as a blocking finding. Confirm definition-of-done items (tests, docs, validation) are done and that declared non-goals are respected (no scope creep).
      - name: yagni
        mandatory: true
      - name: contradiction-lens
        mandatory: true
      - name: renderer-security
        persona: review
        prompt: Review this change for renderer security. Check HTML text escaping, URL encoding, attribute encoding, JSON/script embedding, and rendering of user-controlled content. Treat titles, names, URLs, statuses, errors, and external payload fields as untrusted. Flag raw interpolation into HTML or attributes and tests that expect unsafe output.
    # Operator-directed, and narrower in justification than the draft-gate
    # entry above: the pre-approval gate showed the same non-convergence on the
    # PR that carries this change. Two rounds ran 2 must-fix / 17
    # worth-fixing-now and 2 / 16 — correctness flat, the soft column flat
    # beside it, each pass creating fresh surface for the next.
    #
    # Unlike the draft gate, this IS a relaxation below the shipped default's
    # intent: pre-approval is the last bar before merge, and a worth-fixing-now
    # finding unblocked here is not caught anywhere later. Surviving findings
    # are filed as follow-up issues and named in the verdict, which is the only
    # thing that keeps this from being lossy.
    #
    # Revisit when the round cap lands: the correct shape is the full severity
    # set for the first N rounds, softening only on a demonstrated plateau,
    # rather than a permanently softened final gate.
    blockCleanOnFindingSeverities:
      - must-fix

workflow:
  requireRetrospective: true
  requireDraftFirst: true
  devModeDefault: true

localImplementation:
  lightMode:
    enabled: true
    maxFiles: 2
    maxLines: 20 # micro-PR ceiling (#1043)

tracker:
  board:
    title: "dev-loops Queue"

queue:
  maxParallel: 3
  maxAutoFiledIssues: 10
  reDispatchMaxRetries: 1
  archiveOlderThanDays: 7
