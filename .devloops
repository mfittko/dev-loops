version: 1

strategy: local-first

inputSource: tracker

refinement:
  maxCopilotRounds: 2

gates:
  # Fail-closed enforcement that gate verdicts were produced by the
  # fan-out/fan-in review sub-loop (executionMode fanout_fanin + a findings-log
  # ledger), not an inline single-agent run. This repo runs enforcement on its
  # own gates; dynamic angle resolution (below) scopes the fan-out per change.
  requireFanoutEvidence: true
  # Enforce one distinct reviewer identity per fresh (non-carried) fan-out
  # angle — no two freshly-reviewed angles may share a reviewer, UNLESS they
  # all sit in the SAME recorded dispatch unit (a declared group, an
  # auto-chunked leftover bundle, or a `packed:sha256:` bin that merges
  # configured groups for a single wave) — see GATE-EXEC-FANOUT-CAPACITY and
  # fanoutReviewerPairingError in skills/docs/gate-review-sub-loop-contract.md.
  requireFanoutProvenance: true
  # Bounded-parallel fan-out concurrency: dispatch up to 5 dispatch units
  # concurrently per wave via blocking joins. write-gate-context.mjs packs
  # whole units so every round, including the full 20-angle draft pool, is
  # one wave of at most 5 units x 5 angles. This matches the Claude harness
  # cap (5), so the Claude clamp is a no-op here. The two knobs are
  # independent: queue.maxParallel below stays 3, so the combined peak is
  # 3 runners x 5 units = 15 concurrent reviewer units (plus one driver and
  # one gate coordinator per runner). A transient (429/5xx) dispatch retries
  # on the same unit with backoff before ever reducing concurrency
  # (skills/docs/gate-review-sub-loop-contract.md
  # GATE-EXEC-DISPATCH-RETRY-BACKOFF). If 429s rise, lower queue.maxParallel
  # first; keep maxConcurrent at 5 so one round stays one wave (ADR 0095).
  # This is bounded parallelism, not
  # inline single-agent: distinct-reviewer fan-in/ledger/provenance are
  # unchanged. gates.fanout.sequential (serialize to one dispatch unit per
  # wave) remains the documented LOAD FALLBACK for a child-safe environment
  # that still SIGTERMs heavy reviewers under parallel overload — not the
  # default here. The shipped default is also maxConcurrent: 5 with
  # sequential: false (ADR 0095).
  fanout:
    maxConcurrent: 5
  # Drop the generated .claude mirror trees from the required reviewer diff.
  # scripts/claude/generate-claude-assets.mjs owns every file in them, and
  # test/contracts/claude-assets-reproducible.test.mjs proves byte parity with
  # the canonical sources. The raw-diff read still carries them.
  reviewDiff:
    excludeGlobs:
      - ".claude/skills/**"
      - ".claude/agents/**"
      - ".claude/commands/**"
  draft:
    dynamic:
      subtractive: true
    # Ordered, first-match-wins diff-class angle tiers (GATE-EXEC-DIFF-CLASS-TIER).
    # A tier round is a normal fanout_fanin round with a reduced angle set: the
    # mandatory floor is unioned in regardless, and a config-source-touching or
    # unclassifiable delta falls through to mandatory-floor best-effort selection.
    tiers:
      - name: docs-only
        match: { kinds: [docs], maxLines: 300 }
        angles: [link-check, contract-surface, gate-evidence, deslop] # #1442: prose must run the required deslop angle
      - name: small-non-code
        match: { kinds: [docs, test, config], maxLines: 50 }
        angles: [correctness, gate-evidence, link-check, deslop]
    # Only per-layer DELTAS live here — angles that merely restate an
    # extension-defaults.yaml draft-pool entry byte-for-byte are a no-op under
    # merge-by-name (D3) and have been trimmed. This repo's draft gate keeps
    # the full shipped draft pool at its shipped persona/prompt/order except
    # for the two explicit drops below.
    angles:
      # Shipped in extension-defaults.yaml's draft pool but intentionally not
      # run by this repo's own draft gate (pre-1.0 config-schema redesign,
      # #1404: gates.<gate>.angles now merges BY NAME across config layers —
      # D3 — so dropping a shipped angle requires an explicit enabled:false
      # entry here; omitting it entirely would let it merge back in).
      # threat-model is overridden on a SECURITY_SENSITIVE_SEAM diff: the
      # resolver adds it back once per head in the first gate round.
      - name: threat-model
        enabled: false
      - name: renderer-security
        enabled: false
    requireCi: true
    # Draft gate blocks on high only. With medium also blocking,
    # this gate did not converge on a non-trivial change: correctness settled
    # while medium renewed itself every round, because each fix round
    # creates fresh surface for the next round to review. Measured over eight
    # rounds on one PR (72 reviewer dispatches), high per round ran
    # 1,1,7,0,1,1,3,0 while medium ran 6,11,17,14,16,9,12,7.
    #
    # The judge disposes every finding cluster (act, defer or reject) and owns
    # the verdict: a non-empty act list gives findings_present and an empty one
    # gives clean, whatever the severities. Severity, the round number and the
    # medium fix window (mediumFixWindow) are inputs to the judge. No code path
    # stamps a deferral from severity or round alone. A LOCATABLE finding
    # (in-diff file:line) stays an open PR review thread until the fixer
    # resolves it, the judge defers it, the judge rejects a medium, low or nit
    # (a rejected question needs an answer reply first and a rejected high
    # stays open), or the judge disposes it act with an evidence-only remedy.
    # A NON-LOCATABLE one
    # is body-filed and carries disposition=deferred only on a judge defer
    # (never on a nit, which carries no stamp and no issue link). An
    # unjudged finding stays open. This key lists the severities that the
    # fan-in verdict treats as blocking when no judge ran or a finding stays
    # unjudged (a partly judged ledger keeps the fan-in verdict). A judged
    # round, one where every finding carries a judge disposition, reads it only for the clean-implies-no-blocking-act consistency
    # check, never for the verdict. preApproval's own blockCleanOnFindingSeverities below is
    # high only too. preApproval re-reviews
    # through its own, mostly disjoint angle pool (draft and preApproval share only
    # contradiction-lens) and does not re-raise a draft-gate finding as a
    # fresh finding of its own: fingerprint suppression across gates keeps a
    # deferred draft-gate thread from being re-raised by preApproval's own
    # fan-out. This also affects light-mode dispatch: resolveGateDispatchMode
    # escalates inline to full fan-out only on a blocking-severity inline
    # finding, so a light-dispatched draft PR whose inline pass surfaces only
    # medium stays inline instead of escalating.
    #
    # A deferred finding is recorded on its own thread's resolving reply and in
    # the durable findings-log ledger (GATE-EXEC-DEFERRAL-RECORD), never in a
    # separate summary comment.
    blockCleanOnFindingSeverities:
      - high
  preApproval:
    dynamic:
      subtractive: true
    # Ordered, first-match-wins diff-class angle tiers (GATE-EXEC-DIFF-CLASS-TIER).
    # No inline arm here: this gate's mandatory angles cannot attest per-angle
    # coverage from a single-agent pass, so a tier only ever reduces the
    # fan-out's angle set, never its execution mode.
    tiers:
      - name: small-non-code
        match: { kinds: [docs, test, config], maxLines: 50 }
        angles: [docs]
    # Only per-layer DELTAS live here (see the draft-gate comment above for
    # why byte-identical restatements were trimmed). This repo's preApproval
    # gate keeps the full shipped preApproval pool at its shipped
    # persona/prompt/order except for the deltas below: two angles promoted
    # to mandatory, and two additions not in the shipped preApproval pool.
    # Mandatory angles always run in the fan-out (never dropped by dynamic
    # resolution); fully configurable — set `mandatory: true` on any angle.
    angles:
      - name: acceptance-criteria
        mandatory: true
        persona: review
        prompt: Verify that each acceptance criterion and definition-of-done item from the linked issue/PR is actually satisfied by the implementation — not merely listed. For every criterion, cite the concrete code/test/behavior evidence that meets it; flag any criterion that is unmet, only partially met, or unverifiable from the diff as a blocking finding. Confirm definition-of-done items (tests, docs, validation) are done and that declared non-goals are respected (no scope creep).
      - name: yagni
        mandatory: true
      - name: contradiction-lens
        mandatory: true
      - name: renderer-security
        persona: review
        prompt: Review this change for renderer security. Check HTML text escaping, URL encoding, attribute encoding, JSON/script embedding, and rendering of user-controlled content. Treat titles, names, URLs, statuses, errors, and external payload fields as untrusted. Flag raw interpolation into HTML or attributes and tests that expect unsafe output.
    # Operator-directed, and narrower in justification than the draft-gate
    # entry above: the pre-approval gate showed the same non-convergence on the
    # PR that carries this change. Two rounds ran 2 high / 17
    # medium and 2 / 16 — correctness flat, the soft column flat
    # beside it, each pass creating fresh surface for the next.
    #
    # Unlike the draft gate, this IS a relaxation below the shipped default's
    # intent: pre-approval is the last bar before merge. See the draft-gate
    # entry above for how a LOCATABLE vs NON-LOCATABLE finding is disposed
    # (owned by GATE-EXEC-THREAD-DISPOSITION, GATE-EXEC-DEFERRAL-RECORD,
    # GATE-EXEC-FINDING-THREADS) — it applies here unchanged.
    blockCleanOnFindingSeverities:
      - high

workflow:
  requireRetrospective: true
  requireDraftFirst: true
  devModeDefault: true

localImplementation:
  lightMode:
    enabled: true
    maxFiles: 2
    maxLines: 40 # micro-PR ceiling (ADR 0108)

# Model tiers (skills/docs/pre-pr-review-contract.md).
# Each tier maps to one model per harness (`claude`, `pi`). The `pi` value is
# switchable here in `models.tiers`; no other file needs to change. The Claude
# side is baked from built-in policy into the agent frontmatter.
#   low           routine roles: developer, fixer, dev-loop, gate-coordinator, docs, quality.
#   high          review, judge, refiner and every gate angle.
#   pre-pr-strong the pre-push reviewer.
# Roles resolve a model via resolveRoleModel(config, { role, harness }); phase
# prose and tooling never hardcode one. The repo contract test pins the tier
# structure (which role maps to which tier, which harness key carries a model)
# and never pins a model id (ADR 0175).
models:
  tiers:
    low:
      claude: sonnet
      pi: baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast
    high:
      claude: opus
      pi: baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast
    pre-pr-strong:
      claude: opus
      pi: baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast
  roleTiers:
    pre-push-reviewer: pre-pr-strong
    judge: high
    developer: low
    fixer: low
    dev-loop: low
    gate-coordinator: low

# Extra MCP tools delivered to the Claude developer, fixer and refiner agents
# (issue #2604). Entries must be MCP tool names; hook-guarded roles are rejected.
extraTools:
  developer:
    - mcp__codebase-memory
  fixer:
    - mcp__codebase-memory
  refiner:
    - mcp__codebase-memory

tracker:
  board:
    number: 3  # https://github.com/users/mfittko/projects/3 (stable; survives project renames)

queue:
  maxParallel: 3
  maxAutoFiledIssues: 10
  reDispatchMaxRetries: 1
  archiveOlderThanDays: 7

# Operator override (mfittko, 2026-08-18, ADR 0050): lifts the repo-level bar on
# agent-executed merges so the per-run authorization signal is honored again. The
# operator's standing instruction supplies that authorization for PRs whose full
# gate pipeline passes (draft_gate + pre_approval_gate clean at current head, zero
# unresolved threads, evidence audit green); stopAt and the resolver chain are
# unchanged, so the config alone clears nothing.
autonomy:
  humanMergeOnly: false

# Operator-recorded standing authorization (mfittko, 2026-10-06): lets the ADR
# tripwire waiver writer act on this repo's behalf until the expiry below.
standingAuthorizations:
  adrTripwireWaiver:
    grantedBy: mfittko
    grantedAt: 2026-10-06
    expires: 2027-01-03
    reason: Queue drain; waive contract-doc tripwires that record no new decision

# Gate validation (ADR 0137, amends ADR 0105). This repo uses the ci producer
# (ADR 0137 as amended by ADR 0172). `paths` is this repo's targeted
# worker map for resolveTargetedValidation: first match wins, one surface per
# change set, an empty command list pins matching paths to full validation.
validation:
  mode: ci-only
  paths:
    - { match: "packages/core/test/*.test.mjs", surface: core, commands: ["bun scripts/run-bun-test.mjs {path}"], gateSuites: [test:core] }
    - { match: "packages/core/package.json", surface: core, commands: ["bun run test:core", "bun run test:pack"] }
    - { match: "packages/core/**", surface: core, commands: ["bun run assets:check", "bun run test:core"] }
    - { match: ["test/loop/*.test.mjs", "test/github/*.test.mjs", "test/docs/*.test.mjs", "test/projects/*.test.mjs", "test/pages/*.test.mjs", "test/security/*.test.mjs"], surface: scripts, commands: ["bun scripts/run-bun-test.mjs {path}"], gateSuites: [test:scripts] }
    - { match: "scripts/claude/generate-claude-assets.mjs", surface: generated, commands: ["bun run assets:check", "bun run test:doc-guard"] }
    - { match: ["docs/presentations/introducing-dev-loops.html", "test/playwright/intro-deck.spec.mjs"], surface: ui, commands: ["bun run test:playwright:intro-deck"] }
    - { match: ["docs/presentations/dev-loops-deep-dive.html", "test/playwright/deep-dive.spec.mjs", "test/playwright/deep-dive-deck.spec.mjs"], surface: ui, commands: ["bun run test:playwright:deep-dive"] }
    - { match: ["docs/presentations/how-dev-loops-decided-itself.html", "test/playwright/how-decided-deck.spec.mjs"], surface: ui, commands: ["bun run test:playwright:how-decided-deck"] }
    - { match: ["docs/presentations/state-graph-surface.html", "test/playwright/state-graph-surface-deck.spec.mjs"], surface: ui, commands: ["bun run test:playwright:state-graph-surface-deck"] }
    - { match: ["docs/presentations/finding-the-flow.html", "test/playwright/finding-the-flow-deck.spec.mjs"], surface: ui, commands: ["bun run test:playwright:finding-the-flow-deck"] }
    - { match: ["docs/articles/introducing-dev-loops.html", "test/playwright/intro-article.spec.mjs"], surface: ui, commands: ["bun run test:playwright:intro-article"] }
    - { match: ["docs/articles/dev-loops-deep-dive.html", "test/playwright/deep-dive-article.spec.mjs"], surface: ui, commands: ["bun run test:playwright:deep-dive-article"] }
    - { match: ["docs/articles/how-dev-loops-decided-itself.html", "test/playwright/how-decided-article.spec.mjs"], surface: ui, commands: ["bun run test:playwright:how-decided-article"] }
    - { match: ["docs/articles/simulator.html", "docs/articles/assets/simulator-model.mjs", "test/playwright/simulator-article.spec.mjs"], surface: ui, commands: ["bun run test:playwright:simulator-article"] }
    - { match: ["docs/articles/simulator-overview.html", "docs/articles/assets/simulator-overview-model.mjs", "test/playwright/simulator-overview-article.spec.mjs"], surface: ui, commands: ["bun run test:playwright:simulator-overview-article"] }
    - { match: ["scripts/loop/inspect-run-viewer.mjs", "scripts/loop/inspect-run-viewer/**", "test/playwright/inspect-run-viewer.spec.mjs"], surface: ui, commands: ["bun run test:playwright:viewer"] }
    - { match: ["docs/presentations/*.html", "docs/articles/*.html", "test/playwright/*.spec.mjs"], surface: unregistered-ui, commands: [] }
    - { match: ["scripts/**", "cli/**", "lib/**"], surface: scripts, commands: ["bun run test:scripts"] }
    - { match: ["skills/docs/**", "skills/*/SKILL.md", "docs/**", "AGENTS.md", "README.md"], surface: docs, commands: ["bun run test:docs", "bun run test:doc-guard"] }
    - { match: ".github/workflows/**", surface: workflow, commands: ["bun run test:workflows"] }
    - { match: "extension/**", surface: extension, commands: ["bun run test:extension"] }
    - { match: [".claude/**", "agents/**", "commands/**", "skills/dev-loop/templates/**"], surface: generated, commands: ["bun run assets:check", "bun run test:assets"] }
