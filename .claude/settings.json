{
  "env": {
    "DEVLOOPS_COORDINATOR_READONLY": "1"
  },
  "sandbox": {
    "filesystem": {
      "denyRead": ["~/.config/dev-loops/merge-approvals"]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.config/dev-loops/merge-approvals/**)",
      "Edit(~/.config/dev-loops/merge-approvals/**)",
      "Write(~/.config/dev-loops/merge-approvals/**)",
      "NotebookEdit(~/.config/dev-loops/merge-approvals/**)"
    ],
    "ask": [
      "Bash(dev-loops-run cli/index.mjs decision record *)",
      "Bash(dev-loops-run --repo-root * cli/index.mjs decision record *)"
    ],
    "allow": [
      "Bash(node scripts/github/edit-issue.mjs:*)",
      "Bash(dev-loops-run:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|Grep|Glob|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-approval-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-bash-gate.mjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-write-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-agent-guard.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-ask-approval.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-merge.mjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-stop-uncommitted-guard.mjs"
          }
        ]
      }
    ]
  }
}
